# ============================================================
# Environnement DÉVELOPPEMENT — chargé automatiquement par Vite
# quand NODE_ENV=development (npm run dev)
# ============================================================

# URL de l'API backend Laravel
# En dev : laisser vide → le proxy Vite redirige /api → 8000
# Si besoin d'overrider le proxy : VITE_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000 #http://192.168.100.8:8000


# Port du serveur de développement Vite
# Vite auto-incrémente si le port est occupé (5173 → 5174…)
# Forcer un port fixe évite les surprises
VITE_PORT=5173

# URL du frontend (utilisée pour les redirects OAuth éventuels)
VITE_APP_URL=http://localhost:5173

# Nom affiché dans les onglets / titres
VITE_APP_NAME=SysParc

# Activer les logs de debug axios (true/false)
VITE_API_DEBUG=true


